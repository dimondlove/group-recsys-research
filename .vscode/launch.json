{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run experiment (pilot)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_experiment.py",
      "args": ["configs/pilot.yaml"],
